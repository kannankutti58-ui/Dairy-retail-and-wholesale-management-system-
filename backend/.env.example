# ==============================================================================
# 🥛 KUTTIAMMAL'S DAIRY HUB - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

# Security & Authentication (JWT Secret)
JWT_SECRET=kuttiammal_dairy_jwt_super_secret_production_key_2026_aavin_hub

# MongoDB Compass / MongoDB Atlas Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/aavin_dairy_db

# ------------------------------------------------------------------------------
# 1. Google OAuth 2.0 Integration
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ------------------------------------------------------------------------------
# 2. Meta WhatsApp Cloud API (Graph API v20.0+)
# ------------------------------------------------------------------------------
# Obtain from Meta for Developers -> WhatsApp -> API Setup
# Permanent System User Access Token with 'whatsapp_business_messaging' permission
META_WHATSAPP_TOKEN=EAAG...your_meta_permanent_access_token
META_PHONE_NUMBER_ID=100012345678901
META_BUSINESS_ACCOUNT_ID=200012345678901
META_APP_SECRET=your_meta_app_secret

# ------------------------------------------------------------------------------
# 3. Indian Telecom SMS Gateway (Fast2SMS / MSG91 / Twilio)
# ------------------------------------------------------------------------------
# Fast2SMS API Key (https://www.fast2sms.com/dashboard/dev-api)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Alternative: MSG91 Auth Key & DLT Template ID
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_dlt_template_id

# Alternative: Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 4. Web Push Notification VAPID Keys (Cold Storage & Delivery Alerts)
# ------------------------------------------------------------------------------
# Generate via 'npx web-push generate-vapid-keys' or let server auto-generate for session
VAPID_PUBLIC_KEY=BF7kDEibh9O1N4Da_TGy1K2dLmebxUiliIX74HnHjDj5wyU--G7rLDcreuWZzFvOjbeLIa5mcn8oknEaapS-ncA
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:kuttiammal.dairy@gmail.com

# ------------------------------------------------------------------------------
# 5. Email & SMTP Configuration (Password Reset & Invoices)
# ------------------------------------------------------------------------------
GMAIL_USER=kuttiammal.dairy@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kuttiammal.dairy@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
